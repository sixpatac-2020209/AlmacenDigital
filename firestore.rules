rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Admin operativo: usuario autenticado por email/password (no anónimo)
    function isAdminUser() {
      return isSignedIn() && !isAnonymous();
    }

    // Productos collection
    match /productos/{productId} {
      // Lectura pública
      allow get, list, read: if true;
      // Escritura solo para usuarios admin no anónimos
      allow create, update, delete: if isAdminUser();
    }

    // Categorías collection
    match /categorias/{categoriaId} {
      allow get, list, read: if true;
      allow create, update, delete: if isAdminUser();
    }

    // Pedidos
    match /pedidos/{pedidoId} {
      // Cliente puede crear sin login, con validaciones básicas de payload
      allow create: if request.resource.data.keys().hasOnly(['facturacion', 'envio', 'items', 'subtotal', 'envioCosto', 'total', 'estado', 'createdAt'])
        && request.resource.data.keys().hasAll(['facturacion', 'envio', 'items', 'subtotal', 'envioCosto', 'total', 'estado', 'createdAt'])
        && request.resource.data.facturacion is map
        && request.resource.data.envio is map
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.subtotal is number
        && request.resource.data.envioCosto is number
        && request.resource.data.total is number
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.createdAt is number;

      // Lectura/actualización de pedidos solo para admin no anónimo
      allow get, list, update, delete: if isAdminUser();
    }

    // Denegar cualquier otra colección/documento no definido arriba
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
